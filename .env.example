# SentinelGate Environment Configuration Example

# Server Configuration
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_DEBUG=false
SENTINEL_ENVIRONMENT=production

# Upstream LLM Configuration
# If set to "mock", SentinelGate will use a fast internal deterministic LLM (no external API keys needed)
UPSTREAM_PROVIDER=mock
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-openai-api-key-here
UPSTREAM_TIMEOUT_SECONDS=30.0

# Security & Guardrail Thresholds
GUARDRAIL_ENABLE_INJECTION_DEFENSE=true
GUARDRAIL_INJECTION_THRESHOLD=0.65

GUARDRAIL_ENABLE_PII_MASKING=true
GUARDRAIL_PII_ACTION=mask # 'mask' to replace PII with placeholders, 'block' to reject the request

GUARDRAIL_ENABLE_HALLUCINATION_EVAL=true
GUARDRAIL_HALLUCINATION_THRESHOLD=0.40 # Lexical / semantic distance threshold above which output is flagged

# Semantic Caching
CACHE_ENABLED=true
CACHE_BACKEND=memory # 'memory' or 'redis'
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000
